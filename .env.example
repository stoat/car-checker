# PostgreSQL
POSTGRES_DB=carchecker
POSTGRES_USER=carchecker
POSTGRES_PASSWORD=carchecker

# DVLA Vehicle Enquiry Service API
# Register at: https://developer-portal.driver-vehicle-licensing.api.gov.uk/
DVLA_API_KEY=your_dvla_api_key_here

# DVSA MOT History API
# Register at: https://documentation.history.mot.api.gov.uk/
DVSA_API_KEY=your_dvsa_api_key_here
DVSA_CLIENT_ID=your_dvsa_client_id_here
DVSA_CLIENT_SECRET=your_dvsa_client_secret_here
DVSA_TOKEN_URL=https://login.microsoftonline.com/a455b827-244d-4b79-9f6b-604bcd6c7797/oauth2/v2.0/token
DVSA_SCOPE=https://dvsa.onmicrosoft.com/driver-vehicle-licensing-api/.default

# App settings
LOG_LEVEL=INFO
